            "id": "redis",
            "jobspec": "job \"redis\" {\n  datacenters = [\"dc1\"]\n  type        = \"service\"\n\n  # Constraint to run on core services plane\n  constraint {\n    attribute = \"${node.class}\"\n    value     = \"core\"\n  }\n\n  group \"redis-db\" {\n    count = 1\n\n    network {\n      mode = \"bridge\"\n      port \"db\" {\n        static = 6379  # Fixed port for stable access\n        to = 6379\n      }\n    }\n\n    service {\n      provider = \"nomad\"\n      name     = \"redis\"\n      port     = \"db\"\n      address_mode = \"alloc\"\n\n      check {\n        type     = \"tcp\"\n        interval = \"10s\"\n        timeout  = \"2s\"\n      }\n    }\n\n    task \"redis\" {\n      driver = \"docker\"\n\n      config {\n        image = \"redis:7-alpine\"\n        ports = [\"db\"]\n      }\n\n      resources {\n        cpu    = 200 # MHz\n        memory = 256 # MB\n      }\n\n      restart {\n        attempts = 3\n        interval = \"10m\"\n        delay    = \"30s\"\n        mode     = \"fail\"\n      }\n    }\n  }\n} ",
