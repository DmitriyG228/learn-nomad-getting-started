            "internal_ip": "10.0.0.5",
            "ipxe_chain_url": null,
            "iso_id": null,
            "kvm": "https://my.vultr.com/subs/vps/novnc/api.php?data=djJ8VUJ6akV1UGdkNm5yQ3JnQ2RIUmF0b1hpMWYwSUJrRGZ8VKVp8Eo0OFyo4z8IQj2eG4VL92WZtX7K6ZsifsZ5LSfmqE3WUIGrZJuQuebSCMXyWeWI1bpVJBM8BYDTd82_fl04_g9Dyvf8qGMlobChRWeAAf0tTLZHP8nEdmmYGB8uluMCMtPaEYFNnvRzz2o2XqreVIeBhMcAzJD8buB9ioASScLncZckxlzeU8b_YeU",
            "label": null,
